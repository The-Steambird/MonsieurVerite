<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:themes="clr-namespace:MonsieurVerite.Themes">

    <Style x:Key="HeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QueueHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path x:Name="SortArrow" Style="{StaticResource Icon}"
                                      Data="{StaticResource ChevronDownIcon}"
                                      Width="10" Height="10" Margin="5,0,0,0" StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Stroke="{StaticResource DimBrush}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Margin="-4,0,0,0" Style="{StaticResource HeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Margin="0,0,-4,0" Style="{StaticResource HeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition
                                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                    Value="True" />
                                <Condition
                                    Binding="{Binding Column.CanUserSort, RelativeSource={RelativeSource Self}}"
                                    Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                        </MultiDataTrigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QueueCheckHeaderStyle" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource QueueHeader}">
        <!-- Keeps the checkbox clear of the window's resize border. -->
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="QueueCell" TargetType="DataGridCell"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QueueCheckCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource QueueCell}">
        <Setter Property="Padding" Value="8,0,0,0" />
    </Style>

    <Style x:Key="QueueRow" TargetType="DataGridRow"
           BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="CheckedTint"
                                    Background="{StaticResource CheckedBrush}" Opacity="0" />
                            <Border x:Name="Hover" Background="{StaticResource HoverBrush}"
                                    Opacity="0" />
                            <SelectiveScrollingGrid>
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </SelectiveScrollingGrid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedTint"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedTint"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QueueCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style x:Key="FileNameText" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding FileName}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueNameCell">
        <TextBlock Style="{StaticResource FileNameText}" />
    </DataTemplate>

    <Style x:Key="StateGlyph" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="StrokeThickness" Value="2.25" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="PresentGlyph" TargetType="Path" BasedOn="{StaticResource StateGlyph}">
        <Setter Property="Data" Value="{StaticResource CheckIcon}" />
        <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
    </Style>

    <Style x:Key="KeyPresentGlyph" TargetType="Path" BasedOn="{StaticResource PresentGlyph}">
        <Setter Property="ToolTip" Value="{x:Static local:Strings.KEY_PRESENT_TIP}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="Present">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KeyMissingGlyph" TargetType="Path" BasedOn="{StaticResource StateGlyph}">
        <Setter Property="Data" Value="{StaticResource CrossIcon}" />
        <Setter Property="Stroke" Value="{StaticResource FaintBrush}" />
        <Setter Property="ToolTip" Value="{x:Static local:Strings.KEY_MISSING_TIP}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="Missing">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <!-- Align the pill text with the header rather than the pill itself. -->
        <Setter Property="Margin" Value="-9,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="themes:Motion.FadeOn" Value="{Binding Key}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="Recovered">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="ToolTip" Value="{Binding VideoKey, StringFormat='videoKey={0}'}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KeyStateText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="Recovered">
                <Setter Property="Text" Value="{x:Static local:Strings.KEY_RECOVERED}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueKeyCell">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource KeyPresentGlyph}" />
            <Path Style="{StaticResource KeyMissingGlyph}" />
            <Border Style="{StaticResource KeyPill}">
                <TextBlock Style="{StaticResource KeyStateText}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="SubtitlesPresentGlyph" TargetType="Path" BasedOn="{StaticResource PresentGlyph}">
        <Setter Property="ToolTip" Value="{Binding SubtitlesTip}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSubtitles}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtitlesMissingGlyph" TargetType="Path" BasedOn="{StaticResource StateGlyph}">
        <Setter Property="Data" Value="{StaticResource CrossIcon}" />
        <Setter Property="Stroke" Value="{StaticResource FaintBrush}" />
        <Setter Property="ToolTip" Value="{x:Static local:Strings.NO_SUBTITLES_TIP}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSubtitles}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtitleCountText" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Subtitles.Count}" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSubtitles}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueSubtitlesCell">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource SubtitlesPresentGlyph}" />
            <Path Style="{StaticResource SubtitlesMissingGlyph}" />
            <TextBlock Style="{StaticResource SubtitleCountText}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="QueueSizeCell">
        <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource DimBrush}"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="QueueVersionCell">
        <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource DimBrush}"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="ToolTip" Value="{Binding Detail}" />
        <Setter Property="themes:Motion.FadeOn" Value="{Binding Status}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Detail}" Value="">
                <Setter Property="ToolTipService.IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Pending">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Background" Value="{StaticResource BadSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
        <Setter Property="Text" Value="{Binding StatusLabel}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RunningDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Pulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                             Duration="0:0:0.7" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Pulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueStatusCell">
        <Border Style="{StaticResource StatusPill}">
            <DockPanel>
                <Ellipse Style="{StaticResource RunningDot}" />
                <TextBlock Style="{StaticResource StatusPillText}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <Style x:Key="QueueProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="themes:Motion.Progress" Value="{Binding Progress}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ProgressPercent" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0:0}%}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueProgressCell">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Style="{StaticResource QueueProgressBar}" />
            <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercent}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="QueueCheckHeader">
        <CheckBox Style="{StaticResource QueueCheck}"
                  IsThreeState="False"
                  IsChecked="{Binding DataContext.CheckState, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                  Command="{Binding DataContext.ToggleAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </DataTemplate>

    <DataTemplate x:Key="QueueCheckCell">
        <CheckBox Style="{StaticResource QueueCheck}"
                  IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

</ResourceDictionary>
