<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MonsieurVerite">

    <Style x:Key="MissingVsScriptGlyph" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Stroke" Value="{StaticResource WarnBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasVsScript}" Value="False" />
                    <Condition
                        Binding="{Binding DataContext.Options.UseVapourSynth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FileNameText" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding FileName}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueNameCell">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource FileNameText}" />
            <Path Style="{StaticResource MissingVsScriptGlyph}"
                  Data="{StaticResource FilterOffIcon}"
                  ToolTip="No VapourSynth script for this file — it will be muxed unfiltered" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="StateGlyph" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="StrokeThickness" Value="2.25" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="PresentGlyph" TargetType="Path" BasedOn="{StaticResource StateGlyph}">
        <Setter Property="Data" Value="{StaticResource CheckIcon}" />
        <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
    </Style>

    <Style x:Key="KeyPresentGlyph" TargetType="Path" BasedOn="{StaticResource PresentGlyph}">
        <Setter Property="ToolTip" Value="Key is in keys.json" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="Present">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Storyboard x:Key="PillFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
    </Storyboard>

    <Style x:Key="KeyPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Tag" Value="{Binding Key, NotifyOnTargetUpdated=True}" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard Storyboard="{StaticResource PillFadeIn}" />
            </EventTrigger>
            <DataTrigger Binding="{Binding Key}" Value="Missing">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Key}" Value="Recovered">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="ToolTip" Value="{Binding VideoKey, StringFormat='videoKey={0}'}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KeyStateText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="Missing">
                <Setter Property="Text" Value="Missing" />
                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Key}" Value="Recovered">
                <Setter Property="Text" Value="Recovered" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueKeyCell">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource KeyPresentGlyph}" />
            <Border Style="{StaticResource KeyPill}">
                <TextBlock Style="{StaticResource KeyStateText}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="SubtitlesPresentGlyph" TargetType="Path" BasedOn="{StaticResource PresentGlyph}">
        <Setter Property="ToolTip"
                Value="{Binding SubtitleLanguages, StringFormat='Cached subtitles: {0}'}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSubtitles}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtitlesMissingGlyph" TargetType="Path" BasedOn="{StaticResource StateGlyph}">
        <Setter Property="Data" Value="{StaticResource CrossIcon}" />
        <Setter Property="Stroke" Value="{StaticResource FaintBrush}" />
        <Setter Property="ToolTip"
                Value="No cached subtitles — this file will mux without any subtitle track" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSubtitles}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtitleCountText" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Subtitles.Count}" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasSubtitles}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueSubtitlesCell">
        <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource SubtitlesPresentGlyph}" />
            <Path Style="{StaticResource SubtitlesMissingGlyph}" />
            <TextBlock Style="{StaticResource SubtitleCountText}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="QueueSizeCell">
        <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource DimBrush}"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="QueueVersionCell">
        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource DimBrush}"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="ToolTip" Value="{Binding Detail}" />
        <Setter Property="Tag" Value="{Binding Status, NotifyOnTargetUpdated=True}" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                <BeginStoryboard Storyboard="{StaticResource PillFadeIn}" />
            </EventTrigger>
            <DataTrigger Binding="{Binding Detail}" Value="">
                <Setter Property="ToolTipService.IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Pending">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Background" Value="{StaticResource BadSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
        <Setter Property="Text" Value="{Binding StatusLabel}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RunningDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Pulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                             Duration="0:0:0.7" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Pulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueStatusCell">
        <Border Style="{StaticResource StatusPill}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource RunningDot}" />
                <TextBlock Style="{StaticResource StatusPillText}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <Style x:Key="QueueProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="local:Motion.Progress" Value="{Binding Progress}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ProgressPercent" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0:0}%}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QueueProgressCell">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Style="{StaticResource QueueProgressBar}" />
            <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercent}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="QueueCheckHeader">
        <CheckBox Style="{StaticResource QueueCheck}"
                  IsThreeState="False"
                  IsChecked="{Binding DataContext.CheckState, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                  Command="{Binding DataContext.ToggleAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </DataTemplate>

    <DataTemplate x:Key="QueueCheckCell">
        <CheckBox Style="{StaticResource QueueCheck}"
                  IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

</ResourceDictionary>
