<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyName>charlotte-gui</AssemblyName>
        <RootNamespace>MonsieurVerite</RootNamespace>
        <Product>charlotte</Product>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <DebugType>none</DebugType>
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MonsieurVerite.Tests" />
    </ItemGroup>
    
    <Target Name="VersionFromGitTag" BeforeTargets="GetAssemblyVersion" Condition="'$(Version)' == '1.0.0'">
        <Exec Command="git describe --tags --abbrev=0 --match &quot;[0-9]*&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true"
              StandardOutputImportance="low" StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitTag" />
            <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
        </Exec>
        <PropertyGroup Condition="'$(GitExitCode)' == '0'">
            <Version>$(GitTag)</Version>
        </PropertyGroup>
    </Target>

</Project>
