<local:DialogWindow x:Class="MonsieurVerite.SettingsDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:vm="clr-namespace:MonsieurVerite.ViewModels"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:RunOptions}"
                    Title="Settings" Width="600">

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <StackPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionLabel}" />
                <sys:String x:Key="DefaultAudioTip">All audio tracks are muxed. The selected audio language will be set as default option.</sys:String>
                <sys:String x:Key="DefaultSubtitleTip">All subtitles are muxed. The selected subtitle language will be set as default option.</sys:String>
                <sys:String x:Key="AudioCodecTip">Flac is lossless, the best default option for archival purposes. Opus is 256 kbps VBR and is 3-5x smaller in size while perceptually transparent, but is still lossy technically.</sys:String>
                <sys:String x:Key="CrfTip">x265 quality, 0 to 51. Lower is better in quality and bigger in size.</sys:String>
                <sys:String x:Key="PresetTip">x265 speed against efficiency. Slower presets take longer for a smaller file at the same quality.</sys:String>
                <sys:String x:Key="EngineTip">Path to charlotte-cli.exe.</sys:String>
                <sys:String x:Key="X265ParamsTip">Built-in tuning for the preset. 'ultrafast' to 'medium' uses the same neutral tuning parameters that improve picture quality without affecting encode speed. 'slow' to 'placebo' uses the same but with added parameters for better quality.</sys:String>
            </StackPanel.Resources>

            <TextBlock Style="{StaticResource DialogTitle}" Text="Settings" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource SectionLabel}" Text="ENGINE" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="Engine" ToolTip="{StaticResource EngineTip}" />
                <TextBox x:Name="EngineBox" Grid.Column="1" Style="{StaticResource OptionField}"
                         ToolTip="{StaticResource EngineTip}" />
                <Button Grid.Column="2" Content="Browse…" Style="{StaticResource ActionButton}"
                        Margin="8,0,0,8" VerticalAlignment="Top" Click="Browse_Click" />
                <CheckBox x:Name="UpdateCheck" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource OptionCheck}"
                          Content="Check for updates on startup"
                          ToolTip="Checks for a new Charlotte release each time the app opens." />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="MKV" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default audio"
                                   ToolTip="{StaticResource DefaultAudioTip}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{x:Static vm:RunOptions.AudioLanguages}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code" SelectedValue="{Binding DefaultAudio}"
                                  ToolTip="{StaticResource DefaultAudioTip}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Default subtitle"
                                   ToolTip="{StaticResource DefaultSubtitleTip}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{x:Static vm:RunOptions.SubtitleLanguages}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding DefaultSubtitle}"
                                  ToolTip="{StaticResource DefaultSubtitleTip}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio codec"
                                   ToolTip="{StaticResource AudioCodecTip}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  Width="100"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Static vm:RunOptions.AudioCodecs}"
                                  SelectedItem="{Binding AudioCodec}"
                                  ToolTip="{StaticResource AudioCodecTip}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="RUN" />
                    <CheckBox Style="{StaticResource OptionCheck}" Content="Skip existing"
                              IsChecked="{Binding SkipExisting}"
                              ToolTip="Skips any file whose .mkv is already in the output folder. Useful for resuming an interrupted batch." />
                    <CheckBox Style="{StaticResource OptionCheck}" Content="Flat output"
                              IsChecked="{Binding FlatOutput}"
                              ToolTip="Writes each .mkv straight into the output folder instead of giving every cutscene its own subfolder." />
                    <CheckBox Style="{StaticResource OptionCheck}" Content="Keep intermediates"
                              IsChecked="{Binding KeepIntermediates}"
                              ToolTip="Leaves the decrypted intermediate files (.ivf, .hca, and .ass) on disk after muxing, instead of deleting them." />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="VIDEO" />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="Apply VapourSynth filter"
                              IsChecked="{Binding UseVapourSynth}"
                              ToolTip="Enable VapourSynth filtering to fix video artifacts (mostly banding) due to Hoyo's poor encoding. Very slow and heavy on CPU, can take up to an hour, varied by video length." />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="Burn subtitle into video"
                              IsChecked="{Binding HardSub}"
                              ToolTip="Burn the subtitle into the video. Good for when you're using it somewhere that doesn't support soft subtitles. Re-encodes the video with the x265 settings to the right. No soft subtitles will be muxed." />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                            IsEnabled="{Binding Reencodes}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="X265" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="CRF" ToolTip="{StaticResource CrfTip}" />
                        <TextBox Grid.Column="1" Style="{StaticResource OptionField}" Width="88"
                                 Text="{Binding Crf, StringFormat={}{0:0.#}}"
                                 ToolTip="{StaticResource CrfTip}" />

                        <TextBlock Grid.Column="2" Text="Preset" Margin="12,0,8,8"
                                   ToolTip="{StaticResource PresetTip}" />
                        <ComboBox Grid.Column="3" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{x:Static vm:RunOptions.Presets}"
                                  SelectedItem="{Binding Preset}"
                                  ToolTip="{StaticResource PresetTip}" />
                    </Grid>

                    <TextBlock Text="x265 params" Margin="0,0,0,6"
                               ToolTip="{StaticResource X265ParamsTip}" />
                    <TextBox Style="{StaticResource OptionField}"
                             Height="118" AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}"
                             Text="{Binding X265ParamLines, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{StaticResource X265ParamsTip}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Button Content="Reset to defaults" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Click="Reset_Click"
                        ToolTip="Every setting in this dialog back to what a fresh install has. Nothing is saved until OK." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Click="Ok_Click" />
                    <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</local:DialogWindow>
