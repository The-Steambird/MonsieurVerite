<Window x:Class="MonsieurVerite.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MonsieurVerite.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RunOptions}"
        Title="Settings" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <StackPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionLabel}" />
            </StackPanel.Resources>

            <TextBlock Style="{StaticResource DialogTitle}" Text="Settings" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource SectionLabel}" Text="MKV" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default audio" />
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource OptionCombo}"
                          ItemsSource="{x:Static vm:RunOptions.AudioLanguages}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Code" SelectedValue="{Binding DefaultAudio}"
                          ToolTip="Every dub is muxed; this one is flagged default so players pick it." />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Default subtitle" />
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionCombo}"
                          ItemsSource="{x:Static vm:RunOptions.SubtitleLanguages}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Code" SelectedValue="{Binding DefaultSubtitle}"
                          ToolTip="Every cached subtitle is muxed; this one is flagged default." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio codec" />
                <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OptionCombo}"
                          Width="120"
                          HorizontalAlignment="Left"
                          ItemsSource="{x:Static vm:RunOptions.AudioCodecs}"
                          SelectedItem="{Binding AudioCodec}"
                          ToolTip="flac is lossless, the right default for an archive. opus is 256 kbps VBR: three to five times smaller and transparent in practice, but a re-encode you cannot undo." />
            </Grid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="RUN" />
            <CheckBox Style="{StaticResource OptionCheck}" Content="Skip existing"
                      IsChecked="{Binding SkipExisting}"
                      ToolTip="Skips any file whose .mkv is already in the output folder. Useful for resuming an interrupted batch." />
            <CheckBox Style="{StaticResource OptionCheck}" Content="Flat output"
                      IsChecked="{Binding FlatOutput}"
                      ToolTip="Writes each .mkv straight into the output folder instead of giving every cutscene its own subfolder." />
            <CheckBox Style="{StaticResource OptionCheck}" Content="Keep intermediates"
                      IsChecked="{Binding KeepIntermediates}"
                      ToolTip="Leaves the decrypted .ivf, the per-channel .hca audio and the generated .ass subtitles on disk after muxing, instead of deleting them." />

            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,8,0,10" Text="VAPOURSYNTH" />
            <CheckBox Style="{StaticResource OptionCheck}" Content="Apply VapourSynth filter"
                      IsChecked="{Binding UseVapourSynth}"
                      ToolTip="Runs the matching vs/ script over the video before muxing. Extremely slow: heavy CPU and GPU. Files with no matching script are muxed unfiltered." />

            <Grid Margin="28,0,0,14" IsEnabled="{Binding UseVapourSynth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="CRF" />
                <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource OptionField}"
                         Width="72"
                         HorizontalAlignment="Left"
                         Text="{Binding Crf, StringFormat={}{0:0.#}}"
                         ToolTip="x265 quality, 0 to 51. Lower is better and bigger; 13.5 is near-lossless for these sources." />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Preset" />
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionCombo}"
                          Width="140"
                          HorizontalAlignment="Left"
                          ItemsSource="{x:Static vm:RunOptions.Presets}"
                          SelectedItem="{Binding Preset}"
                          ToolTip="x265 speed against efficiency. Slower presets take longer for a smaller file at the same quality." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="x265 params" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OptionField}"
                         Text="{Binding X265Params, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Colon-separated x265 parameters. Replaces the built-in tuning entirely, so leave empty unless you know what you are overriding." />
            </Grid>

            <TextBlock Style="{StaticResource DialogCaption}" Margin="0,0,0,20">
                Recovered keys are written to <Run x:Name="RecoveredKeysRun" />.
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Ok_Click" />
                <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Close_Click" />
    </Grid>
</Window>
