<views:DialogWindow x:Class="MonsieurVerite.Views.MessageDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:views="clr-namespace:MonsieurVerite.Views"
                    Width="460" KeyDown="Window_KeyDown"
                    Hyperlink.RequestNavigate="OpenLink">

    <Grid>
        <Grid Style="{StaticResource DialogRoot}">
            <Grid.Resources>
                <Style TargetType="Hyperlink" BasedOn="{StaticResource QuietLink}" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource DialogTitle}" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource DialogBody}" />

            <Border x:Name="DetailPanel" Grid.Row="2" Margin="0,14,0,0" Padding="12,10"
                    Background="{StaticResource LayerBrush}"
                    BorderBrush="{StaticResource LineStrongBrush}"
                    BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailText" FontSize="12"
                               Foreground="{StaticResource DimBrush}"
                               TextWrapping="Wrap" LineHeight="18" />
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="NotesPanel" Grid.Row="3" Margin="0,18,0,0" Visibility="Collapsed">
                <Border Height="1" Margin="-24,0" Background="{StaticResource LineBrush}" />
                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotesContent" Margin="0,16,14,6" />
                </ScrollViewer>
                <Border Height="1" Margin="-24,0" Background="{StaticResource LineBrush}" />
            </StackPanel>

            <DockPanel Grid.Row="4" Margin="0,20,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="Primary_Click" />
                    <Button x:Name="SecondaryButton" Style="{StaticResource ActionButton}"
                            IsCancel="True"
                            Margin="8,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="NotesLinkText" VerticalAlignment="Center" Visibility="Collapsed">
                    <Hyperlink x:Name="NotesLink">
                        <Run Text="{x:Static local:Strings.VIEW_ON_GITHUB}" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
        </Grid>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</views:DialogWindow>
