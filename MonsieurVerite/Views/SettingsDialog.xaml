<views:DialogWindow x:Class="MonsieurVerite.Views.SettingsDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:views="clr-namespace:MonsieurVerite.Views"
                    xmlns:vm="clr-namespace:MonsieurVerite.ViewModels"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:RunOptions}"
                    Title="{x:Static local:Strings.SETTINGS_TITLE}" Width="600">

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <StackPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource OptionLabel}" />
            </StackPanel.Resources>

            <TextBlock Style="{StaticResource DialogTitle}"
                       Text="{x:Static local:Strings.SETTINGS_TITLE}" Margin="0,0,0,16" />
            <TextBlock Style="{StaticResource SectionLabel}"
                       Text="{x:Static local:Strings.GENERAL_SECTION}" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Static local:Strings.ENGINE}"
                           ToolTip="{x:Static local:Strings.ENGINE_TIP}" />
                <TextBox x:Name="EngineBox" Grid.Column="1" Style="{StaticResource OptionField}"
                         ToolTip="{x:Static local:Strings.ENGINE_TIP}" />
                <Button Grid.Column="2" Content="{x:Static local:Strings.BROWSE}"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,8" VerticalAlignment="Top" Click="Browse_Click" />
                <CheckBox x:Name="UpdateCheck" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          Style="{StaticResource OptionCheck}"
                          Content="{x:Static local:Strings.CHECK_FOR_UPDATES_ON_STARTUP}"
                          ToolTip="{x:Static local:Strings.CHECK_FOR_UPDATES_ON_STARTUP_TIP}" />
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource LanguagesIcon}"
                          TextElement.Foreground="{StaticResource DimBrush}" Margin="0,0,6,8" />
                    <TextBlock Text="{x:Static local:Strings.DISPLAY_LANGUAGE}" />
                </StackPanel>
                <ComboBox x:Name="LanguageBox" Grid.Row="2" Grid.Column="1"
                          Style="{StaticResource OptionCombo}" Width="240"
                          HorizontalAlignment="Left" DisplayMemberPath="Name" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="{x:Static local:Strings.MKV_SECTION}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Static local:Strings.DEFAULT_AUDIO}"
                                   ToolTip="{x:Static local:Strings.DEFAULT_AUDIO_TIP}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{x:Static vm:RunOptions.AudioLanguages}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code" SelectedValue="{Binding DefaultAudio}"
                                  ToolTip="{x:Static local:Strings.DEFAULT_AUDIO_TIP}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Static local:Strings.DEFAULT_SUBTITLE}"
                                   ToolTip="{x:Static local:Strings.DEFAULT_SUBTITLE_TIP}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{x:Static vm:RunOptions.SubtitleLanguages}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding DefaultSubtitle}"
                                  ToolTip="{x:Static local:Strings.DEFAULT_SUBTITLE_TIP}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{x:Static local:Strings.AUDIO_CODEC}"
                                   ToolTip="{x:Static local:Strings.AUDIO_CODEC_TIP}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  Width="100"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{x:Static vm:RunOptions.AudioCodecs}"
                                  SelectedItem="{Binding AudioCodec}"
                                  ToolTip="{x:Static local:Strings.AUDIO_CODEC_TIP}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="{x:Static local:Strings.RUN_SECTION}" />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="{x:Static local:Strings.SKIP_EXISTING}"
                              IsChecked="{Binding SkipExisting}"
                              ToolTip="{x:Static local:Strings.SKIP_EXISTING_TIP}" />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="{x:Static local:Strings.FLAT_OUTPUT}"
                              IsChecked="{Binding FlatOutput}"
                              ToolTip="{x:Static local:Strings.FLAT_OUTPUT_TIP}" />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="{x:Static local:Strings.KEEP_INTERMEDIATES}"
                              IsChecked="{Binding KeepIntermediates}"
                              ToolTip="{x:Static local:Strings.KEEP_INTERMEDIATES_TIP}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="{x:Static local:Strings.VIDEO_SECTION}" />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="{x:Static local:Strings.APPLY_VAPOUR_SYNTH}"
                              IsChecked="{Binding UseVapourSynth}"
                              ToolTip="{x:Static local:Strings.APPLY_VAPOUR_SYNTH_TIP}" />
                    <CheckBox Style="{StaticResource OptionCheck}"
                              Content="{x:Static local:Strings.HARD_SUB}"
                              IsChecked="{Binding HardSub}"
                              ToolTip="{x:Static local:Strings.HARD_SUB_TIP}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"
                            IsEnabled="{Binding Reencodes}">
                    <TextBlock Style="{StaticResource SectionLabel}"
                               Text="{x:Static local:Strings.X265_SECTION}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Static local:Strings.CRF}"
                                   ToolTip="{x:Static local:Strings.CRF_TIP}" />
                        <TextBox Grid.Column="1" Style="{StaticResource OptionField}" Width="88"
                                 Text="{Binding EffectiveCrf, StringFormat={}{0:0.#}}"
                                 ToolTip="{x:Static local:Strings.CRF_TIP}" />

                        <TextBlock Grid.Column="2" Text="{x:Static local:Strings.PRESET}"
                                   Margin="12,0,8,8"
                                   ToolTip="{x:Static local:Strings.PRESET_TIP}" />
                        <ComboBox Grid.Column="3" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{x:Static vm:RunOptions.Presets}"
                                  SelectedItem="{Binding EffectivePreset}"
                                  ToolTip="{x:Static local:Strings.PRESET_TIP}" />
                    </Grid>

                    <TextBlock Text="{x:Static local:Strings.X265_PARAMS}" Margin="0,0,0,6"
                               ToolTip="{x:Static local:Strings.X265_PARAMS_TIP}" />
                    <TextBox Style="{StaticResource OptionField}"
                             Height="118" AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}"
                             Text="{Binding X265ParamLines, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static local:Strings.X265_PARAMS_TIP}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Button Content="{x:Static local:Strings.RESET_TO_DEFAULTS}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Click="Reset_Click"
                        ToolTip="{x:Static local:Strings.RESET_TO_DEFAULTS_TIP}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static local:Strings.OK}"
                            Style="{StaticResource PrimaryButton}" IsDefault="True"
                            Click="Ok_Click" />
                    <Button Content="{x:Static local:Strings.CANCEL}"
                            Style="{StaticResource ActionButton}" IsCancel="True"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</views:DialogWindow>
