<views:DialogWindow x:Class="MonsieurVerite.Views.KeyDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:views="clr-namespace:MonsieurVerite.Views"
                    Title="{x:Static local:Strings.SET_KEY_TITLE}" Width="460"
                    FocusManager.FocusedElement="{Binding ElementName=KeyBox}">

    <views:DialogWindow.Resources>
        <Style x:Key="KeyField" TargetType="TextBox" BasedOn="{StaticResource OptionField}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </views:DialogWindow.Resources>

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" />
            <TextBlock x:Name="Caption" Style="{StaticResource DialogBody}" Margin="0,0,0,12" />

            <TextBlock x:Name="KeyLabel" Style="{StaticResource OptionLabel}"
                       Margin="0,0,0,4" />
            <TextBox x:Name="KeyBox" Style="{StaticResource KeyField}"
                     TextChanged="KeyBox_TextChanged" />
            <TextBlock Style="{StaticResource DialogCaption}" Margin="0,0,0,16"
                       Text="{x:Static local:Strings.DECIMAL_KEY_FORMAT}" />

            <StackPanel x:Name="AesKeyPanel">
                <TextBlock Style="{StaticResource OptionLabel}"
                           Text="{x:Static local:Strings.VIDEO_KEY}" Margin="0,0,0,4" />
                <TextBox x:Name="AesKeyBox" Style="{StaticResource KeyField}"
                         TextChanged="KeyBox_TextChanged" />
                <TextBlock Style="{StaticResource DialogCaption}" Margin="0,0,0,16"
                           Text="{x:Static local:Strings.HEX_KEY_FORMAT}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="OkButton" Content="{x:Static local:Strings.START}"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" Click="Ok_Click" />
                <Button Content="{x:Static local:Strings.CANCEL}"
                        Style="{StaticResource ActionButton}" IsCancel="True"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</views:DialogWindow>
