<views:DialogWindow x:Class="MonsieurVerite.Views.AboutDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:views="clr-namespace:MonsieurVerite.Views"
                    Title="{x:Static local:Strings.ABOUT_CHARLOTTE}" Width="460"
                    Hyperlink.RequestNavigate="OpenLink">

    <views:DialogWindow.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="Hyperlink" BasedOn="{StaticResource QuietLink}" />
    </views:DialogWindow.Resources>

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" />
            <TextBlock Style="{StaticResource DialogBody}"
                       Text="{x:Static local:Strings.ABOUT_BLURB}" />

            <Border Margin="0,14,0,0" Padding="12,10"
                    Background="{StaticResource LayerBrush}"
                    BorderBrush="{StaticResource LineStrongBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}"
                               Text="{x:Static local:Strings.BUILD}" />
                    <TextBlock x:Name="BuildText" Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource Value}"
                               FontFamily="{StaticResource MonoFont}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}"
                               Text="{x:Static local:Strings.ENGINE}" />
                    <TextBlock x:Name="EngineText" Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource Value}" />
                </Grid>
            </Border>

            <TextBlock x:Name="CreditsText" Style="{StaticResource DialogBody}" Margin="0,16,0,0" />

            <TextBlock x:Name="SponsorText" Style="{StaticResource DialogBody}" Margin="0,12,0,0">
                <Run FontFamily="{StaticResource IconFont}" FontSize="12"
                     Foreground="{StaticResource AccentBrush}" BaselineAlignment="Center"
                     Text="&#xEB52;" />
            </TextBlock>

            <TextBlock Style="{StaticResource DialogCaption}" Margin="0,16,0,0"
                       Text="{x:Static local:Strings.COPYRIGHT}" />

            <Grid Margin="0,14,0,0">
                <TextBlock VerticalAlignment="Center" FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/The-Steambird/charlotte">GitHub</Hyperlink>
                    <Run Foreground="{StaticResource FaintBrush}"> · </Run>
                    <Hyperlink NavigateUri="https://github.com/The-Steambird/charlotte/issues">
                        <Run Text="{x:Static local:Strings.REPORT_ISSUE}" />
                    </Hyperlink>
                    <Run Foreground="{StaticResource FaintBrush}"> · </Run>
                    <Hyperlink
                        NavigateUri="https://github.com/The-Steambird/charlotte/blob/master/LICENSE">
                        <Run Text="{x:Static local:Strings.LICENSE}" />
                    </Hyperlink>
                </TextBlock>
                <Button Content="{x:Static local:Strings.OK}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        IsDefault="True" IsCancel="True" />
            </Grid>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</views:DialogWindow>
