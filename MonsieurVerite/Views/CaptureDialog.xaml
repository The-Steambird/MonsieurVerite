<views:DialogWindow x:Class="MonsieurVerite.Views.CaptureDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    xmlns:views="clr-namespace:MonsieurVerite.Views"
                    xmlns:vm="clr-namespace:MonsieurVerite.ViewModels"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:KeyCapture}"
                    Title="{x:Static local:Strings.CAPTURE_TITLE}" Width="620">

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <TextBlock Style="{StaticResource DialogTitle}"
                       Text="{x:Static local:Strings.CAPTURE_TITLE}" />
            <TextBlock Style="{StaticResource DialogBody}" Margin="0,0,0,14"
                       Text="{x:Static local:Strings.CAPTURE_INSTRUCTIONS}" />

            <Grid Margin="0,0,0,8">
                <CheckBox Style="{StaticResource OptionCheck}" VerticalAlignment="Center"
                          Margin="0" Content="{x:Static local:Strings.CAPTURE_NEW_ONLY}"
                          ToolTip="{x:Static local:Strings.CAPTURE_NEW_ONLY_TIP}"
                          IsChecked="{Binding NewKeysOnly}" />
                <Button Style="{StaticResource ActionButton}" HorizontalAlignment="Right"
                        Command="{Binding CopyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource CopyIcon}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static local:Strings.COPY_ALL}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox Style="{StaticResource ReadOnlyPanel}" Height="300"
                     Text="{Binding Text, Mode=OneWay}" />

            <!-- Two lines are always reserved, which keeps the dialog's height still as the
                 status changes. A longer line is cut short, and the main log has it whole. -->
            <TextBlock Height="40" Margin="0,10,0,0" Text="{Binding Status.Text}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DialogBody}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.IsWarning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Command="{Binding ToggleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="10" Height="12" Stretch="Uniform" Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource PlayIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Data"
                                                    Value="{StaticResource StopIcon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding ButtonLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Static local:Strings.CLOSE}"
                        Style="{StaticResource ActionButton}" IsCancel="True"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</views:DialogWindow>
