<local:DialogWindow x:Class="MonsieurVerite.KeyDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MonsieurVerite"
                    Title="Set key" Width="460"
                    FocusManager.FocusedElement="{Binding ElementName=KeyBox}">

    <local:DialogWindow.Resources>
        <Style x:Key="KeyField" TargetType="TextBox" BasedOn="{StaticResource OptionField}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </local:DialogWindow.Resources>

    <Grid>
        <StackPanel Style="{StaticResource DialogRoot}">
            <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" Text="Decryption key" />
            <TextBlock x:Name="Caption" Style="{StaticResource DialogBody}" Margin="0,0,0,12" />

            <TextBlock x:Name="KeyLabel" Style="{StaticResource OptionLabel}" Text="Video key"
                       Margin="0,0,0,4" />
            <TextBox x:Name="KeyBox" Style="{StaticResource KeyField}"
                     TextChanged="KeyBox_TextChanged" />
            <TextBlock Style="{StaticResource DialogCaption}" Margin="0,0,0,16"
                       Text="Format: decimal integer. Example: 6542161829131848" />

            <StackPanel x:Name="AesKeyPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource OptionLabel}" Text="Video key" Margin="0,0,0,4" />
                <TextBox x:Name="AesKeyBox" Style="{StaticResource KeyField}"
                         TextChanged="KeyBox_TextChanged" />
                <TextBlock Style="{StaticResource DialogCaption}" Margin="0,0,0,16"
                           Text="Format: 32 hexadecimal characters. Example: f9e9e1c5cf3a68deffa0a4d3df665836" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="OkButton" Content="Convert" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" Click="Ok_Click" />
                <Button Content="Cancel" Style="{StaticResource ActionButton}" IsCancel="True"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
        <Button Style="{StaticResource DialogCloseButton}" Content="&#xE8BB;" Click="Dismiss" />
    </Grid>
</local:DialogWindow>
