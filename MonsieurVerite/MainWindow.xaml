<Window x:Class="MonsieurVerite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonsieurVerite"
        xmlns:vm="clr-namespace:MonsieurVerite.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MonsieurVerite" Height="760" Width="1120" MinHeight="520" MinWidth="860"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop">

    <!-- Layout only. Brushes and shared styles live in Themes/Brushes.xaml and Themes/Styles.xaml;
         the queue's cell templates in Themes/QueueTemplates.xaml. All three are merged in
         App.xaml. Run options live in SettingsDialog.xaml, off the toolbar's Settings button.
         The whole window accepts drops: a folder replaces the queue, .usm files append to it.
         No Background on purpose: Fluent's window style leaves it transparent so the Mica
         backdrop shows through (see Brushes.xaml), and paints it solid where there is none. -->

    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="OpenFolder_Executed"
                        CanExecute="WhenIdle_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.AddFilesCommand}"
                        Executed="AddFiles_Executed" CanExecute="WhenIdle_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.SettingsCommand}"
                        Executed="Settings_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="Open" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift"
                    Command="{x:Static local:MainWindow.AddFilesCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl"
                    Command="{x:Static local:MainWindow.SettingsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="48" Background="{StaticResource LayerBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource LogoIcon}"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Width="18"
                          Height="18" Margin="2,0,8,0" />
                    <TextBlock Text="MonsieurVerite" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource ToolbarButton}" Command="Open"
                            ToolTip="Open folder (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource FolderOpenIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Open folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:MainWindow.AddFilesCommand}"
                            ToolTip="Add files (Ctrl+Shift+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource FilePlusIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Add files" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{x:Static local:MainWindow.SettingsCommand}"
                            ToolTip="Settings (Ctrl+,)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource SlidersIcon}" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource ToolbarIconButton}"
                            Click="More_Click" ToolTip="More">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open output folder"
                                          Command="{Binding OpenOutputFolderCommand}" />
                                <MenuItem Header="Show recovered keys"
                                          Click="ShowRecoveredKeys_Click" />
                                <Separator />
                                <MenuItem Header="Check for updates…"
                                          Command="{Binding CheckForUpdatesCommand}" />
                                <MenuItem Header="About MonsieurVerite" Click="About_Click" />
                                <Separator />
                                <MenuItem Header="Exit" Click="Exit_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource MoreIcon}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="Queue"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" CanUserReorderColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      ColumnHeaderStyle="{StaticResource QueueHeader}"
                      RowStyle="{StaticResource QueueRow}" CellStyle="{StaticResource QueueCell}"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      FontSize="13" RowHeight="42" BorderThickness="0" Background="Transparent"
                      PreviewMouseLeftButtonDown="Queue_PreviewMouseLeftButtonDown">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove from queue"
                                  Command="{Binding RemoveCheckedCommand}" />
                        <MenuItem Header="Recover key" Command="{Binding RecoverKeysCommand}" />
                        <MenuItem Header="Set key and convert…" IsEnabled="{Binding CanSetKey}"
                                  Click="SetKey_Click" />
                        <MenuItem Header="Copy videoKey" IsEnabled="{Binding CanCopyVideoKey}"
                                  Click="CopyVideoKey_Click" />
                        <Separator />
                        <MenuItem Header="Open output folder"
                                  Command="{Binding OpenOutputFolderCommand}" />
                        <MenuItem Header="Uncheck all" Command="{Binding ClearSelectionCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False"
                                            HeaderStyle="{StaticResource QueueCheckHeaderStyle}"
                                            HeaderTemplate="{StaticResource QueueCheckHeader}"
                                            CellStyle="{StaticResource QueueCheckCellStyle}"
                                            CellTemplate="{StaticResource QueueCheckCell}" />
                    <DataGridTemplateColumn Header="NAME" Width="*" MinWidth="160"
                                            SortMemberPath="FileName"
                                            CellTemplate="{StaticResource QueueNameCell}" />
                    <DataGridTemplateColumn Header="VERSION" Width="96" MinWidth="60"
                                            SortMemberPath="VersionOrder"
                                            CellTemplate="{StaticResource QueueVersionCell}" />
                    <DataGridTemplateColumn Header="KEY" Width="100" MinWidth="60"
                                            SortMemberPath="Key"
                                            CellTemplate="{StaticResource QueueKeyCell}" />
                    <DataGridTemplateColumn Header="STATUS" Width="124" MinWidth="80"
                                            SortMemberPath="Status"
                                            CellTemplate="{StaticResource QueueStatusCell}" />
                    <DataGridTemplateColumn Header="PROGRESS" Width="172" MinWidth="100"
                                            SortMemberPath="Progress"
                                            CellTemplate="{StaticResource QueueProgressCell}" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Style="{StaticResource EmptyState}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource InboxIcon}" Width="40"
                      Height="40"
                      Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5"
                      Margin="0,0,0,14" />
                <TextBlock Text="Drop a folder or .usm files here" FontSize="14"
                           Foreground="{StaticResource DimBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="or open a folder with Ctrl+O" FontSize="12"
                           Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <Rectangle Style="{StaticResource BusyBar}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource LayerBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ToggleButton Style="{StaticResource LogToggle}" IsChecked="{Binding IsLogOpen}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LogChevron}"
                              Data="{StaticResource ChevronDownIcon}" />
                        <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Border Style="{StaticResource LogPane}">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Height="120"
                             Margin="8,0,8,8"
                             VerticalAlignment="Top" BorderThickness="0" Background="Transparent"
                             Padding="0"
                             ItemContainerStyle="{StaticResource LogLine}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="CopyLog_Click" />
                                <MenuItem Header="Copy all" Click="CopyAllLog_Click" />
                                <Separator />
                                <MenuItem Header="Clear" Command="{Binding ClearLogCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Height="56" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding StartCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryBarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlayIcon}" Width="10" Height="12"
                                  Stretch="Uniform" Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel" Padding="22,0" MinWidth="104"
                            Command="{Binding CancelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarDivider}"
                        Margin="12,0" />

                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource BarButton}"
                        Click="BrowseOutput_Click"
                        ToolTip="Choose the output folder">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource FolderIcon}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Browse" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="Output" FontSize="12"
                           Foreground="{StaticResource FaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Style="{StaticResource PathBox}"
                         Text="{Binding OutputDirectory, UpdateSourceTrigger=LostFocus}"
                         KeyDown="OutputBox_KeyDown" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Height="26" Background="{StaticResource LayerBrush}"
                   LastChildFill="False">
            <DockPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarText}" />
            </DockPanel.Resources>
            <TextBlock DockPanel.Dock="Left" Margin="12,0" Text="{Binding Summary}" />
            <TextBlock DockPanel.Dock="Right" Margin="12,0" Text="{Binding StageText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <Grid x:Name="DropOverlay" Grid.RowSpan="5" Opacity="0" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource WindowBrush}" Opacity="0.7" />
            <Rectangle Margin="10" RadiusX="8" RadiusY="8" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" StrokeDashArray="6,4"
                       Fill="{StaticResource AccentSoftBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource DownloadIcon}" Width="36"
                      Height="36"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.75"
                      Margin="0,0,0,12" />
                <TextBlock Text="Drop to add to the queue" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="A folder replaces the queue; files are added to it" FontSize="12"
                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
