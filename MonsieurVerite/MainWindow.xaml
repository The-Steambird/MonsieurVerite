<Window x:Class="MonsieurVerite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MonsieurVerite.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="charlotte" Height="802" Width="1120" MinHeight="520" MinWidth="860"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding BrowseFilesCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding EditSettingsCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle x:Name="Bleed" Grid.RowSpan="5" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Border x:Name="Toolbar" Grid.Row="0" Height="48" Background="{StaticResource LayerBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource LogoIcon}"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Width="18"
                          Height="18" Margin="2,0,8,0" />
                    <TextBlock Text="charlotte" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Border Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding OpenFolderCommand}"
                            ToolTip="Open folder (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource FolderOpenIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Open folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding BrowseFilesCommand}"
                            ToolTip="Add files (Ctrl+Shift+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource FilePlusIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Add files" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding EditSettingsCommand}"
                            ToolTip="Settings (Ctrl+,)">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource GearIcon}" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource ToolbarIconButton}"
                            Click="More_Click" ToolTip="More">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem Header="Open output folder"
                                          Command="{Binding OpenOutputFolderCommand}" />
                                <MenuItem Header="Show recovered keys"
                                          Click="ShowRecoveredKeys_Click" />
                                <Separator />
                                <MenuItem Header="Check for updates…"
                                          Command="{Binding CheckForUpdatesCommand}" />
                                <MenuItem Header="About charlotte" Click="About_Click" />
                                <Separator />
                                <MenuItem Header="Exit" Click="Exit_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Style="{StaticResource Icon}" Data="{StaticResource MoreIcon}" />
                    </Button>
                    <Border Style="{StaticResource ToolbarDivider}" Margin="8,0" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Click="Maximize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            Click="Exit_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="Queue"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" CanUserReorderColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      ColumnHeaderStyle="{StaticResource QueueHeader}"
                      RowStyle="{StaticResource QueueRow}" CellStyle="{StaticResource QueueCell}"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      FontSize="13" RowHeight="42" BorderThickness="0" Background="Transparent"
                      PreviewMouseLeftButtonDown="Queue_PreviewMouseLeftButtonDown">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove from queue"
                                  Command="{Binding RemoveCheckedCommand}" />
                        <MenuItem Header="Recover key" Command="{Binding RecoverKeysCommand}" />
                        <MenuItem Header="Set key and convert…" IsEnabled="{Binding CanSetKey}"
                                  Click="SetKey_Click" />
                        <MenuItem Header="Copy videoKey" IsEnabled="{Binding CanCopyVideoKey}"
                                  Click="CopyVideoKey_Click" />
                        <MenuItem Header="Retry failed" Command="{Binding RetryFailedCommand}" />
                        <Separator />
                        <MenuItem Header="Open output folder"
                                  Command="{Binding OpenOutputFolderCommand}" />
                        <MenuItem Header="Uncheck all" Command="{Binding UncheckAllCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False"
                                            HeaderStyle="{StaticResource QueueCheckHeaderStyle}"
                                            HeaderTemplate="{StaticResource QueueCheckHeader}"
                                            CellStyle="{StaticResource QueueCheckCellStyle}"
                                            CellTemplate="{StaticResource QueueCheckCell}" />
                    <DataGridTemplateColumn Header="NAME" Width="*" MinWidth="250"
                                            SortMemberPath="FileName"
                                            CellTemplate="{StaticResource QueueNameCell}" />
                    <DataGridTemplateColumn Header="SIZE" Width="90" MinWidth="60"
                                            SortMemberPath="Size"
                                            CellTemplate="{StaticResource QueueSizeCell}" />
                    <DataGridTemplateColumn Header="VERSION" Width="90" MinWidth="65"
                                            SortMemberPath="VersionOrder"
                                            CellTemplate="{StaticResource QueueVersionCell}" />
                    <DataGridTemplateColumn Header="KEY" Width="90" MinWidth="80"
                                            SortMemberPath="Key"
                                            CellTemplate="{StaticResource QueueKeyCell}" />
                    <DataGridTemplateColumn Header="SUBTITLES" Width="90" MinWidth="60"
                                            SortMemberPath="HasSubtitles"
                                            CellTemplate="{StaticResource QueueSubtitlesCell}" />
                    <DataGridTemplateColumn Header="STATUS" Width="90" MinWidth="80"
                                            SortMemberPath="Status"
                                            CellTemplate="{StaticResource QueueStatusCell}" />
                    <DataGridTemplateColumn Header="PROGRESS" Width="230" MinWidth="150"
                                            SortMemberPath="Progress"
                                            CellTemplate="{StaticResource QueueProgressCell}" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Style="{StaticResource EmptyState}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource InboxIcon}" Width="40"
                      Height="40"
                      Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5"
                      Margin="0,0,0,14" />
                <TextBlock Text="Nothing to report yet" FontSize="14"
                           Foreground="{StaticResource DimBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drop a folder or .usm files here, or open a folder with Ctrl+O"
                           FontSize="12"
                           Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <Rectangle Style="{StaticResource BusyBar}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource LayerBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ToggleButton Style="{StaticResource LogToggle}" IsChecked="{Binding IsLogOpen}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LogChevron}"
                              Data="{StaticResource ChevronDownIcon}" />
                        <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Border Style="{StaticResource LogPane}">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Height="120"
                             Margin="8,0,8,8"
                             VerticalAlignment="Top" BorderThickness="0" Background="Transparent"
                             Padding="0"
                             ItemContainerStyle="{StaticResource LogLine}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="CopyLog_Click" />
                                <MenuItem Header="Copy all" Click="CopyAllLog_Click" />
                                <Separator />
                                <MenuItem Header="Clear" Command="{Binding ClearLogCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Height="56" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding StartCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlayIcon}" Width="10" Height="12"
                                  Stretch="Uniform" Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
                        </StackPanel.Resources>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Skip file" Command="{Binding SkipCommand}"
                                ToolTip="Drop the file being converted and carry on with the rest" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarDivider}"
                        Margin="12,0" />

                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding BrowseOutputCommand}"
                        ToolTip="Choose the output folder">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource FolderIcon}"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Browse" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="Output" FontSize="12"
                           Foreground="{StaticResource FaintBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Style="{StaticResource PathBox}"
                         Text="{Binding OutputDirectory, UpdateSourceTrigger=LostFocus}"
                         KeyDown="OutputBox_KeyDown" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Height="26" Background="{StaticResource LayerBrush}"
                   LastChildFill="False">
            <DockPanel.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarText}" />
            </DockPanel.Resources>
            <TextBlock DockPanel.Dock="Left" Margin="12,0" Text="{Binding Summary}" />
            <TextBlock DockPanel.Dock="Right" Margin="12,0" Text="{Binding StageText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- Dims the window under a dialog, whose own frost blurs what shows through. -->
        <Rectangle x:Name="ModalShade" Grid.RowSpan="5" Fill="{StaticResource ShadeBrush}"
                   Opacity="0" IsHitTestVisible="False" />

        <Grid x:Name="DropOverlay" Grid.RowSpan="5" Opacity="0" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource WindowBrush}" Opacity="0.7" />
            <Rectangle Margin="10" RadiusX="8" RadiusY="8" Stroke="{StaticResource AccentBrush}"
                       StrokeThickness="2" StrokeDashArray="6,4"
                       Fill="{StaticResource AccentSoftBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource DownloadIcon}" Width="36"
                      Height="36"
                      Stroke="{StaticResource AccentBrush}"
                      Margin="0,0,0,12" />
                <TextBlock Text="Drop to add to the queue" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="A folder replaces the queue; files are added to it" FontSize="12"
                           Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
