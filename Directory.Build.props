<Project>

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Without EnforceCodeStyleInBuild the IDE#### style rules run only in the IDE and never
             at build or in CI. -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- IDE0005 (unused usings) does nothing unless the XML doc file is generated, and
             generating it raises CS1591 for every public member without an XML comment. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- ThemeMode is [Experimental]. App.xaml.cs sets it from C# because ReSharper flags the
             attribute in App.xaml, and NoWarn cannot reach ReSharper. -->
        <NoWarn>$(NoWarn);WPF0001</NoWarn>

        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- System.IO cannot be a global using here, because the WPF SDK removes it after this
             file to avoid the Path collision with System.Windows.Shapes. -->
        <Using Include="System.Diagnostics" />
    </ItemGroup>

</Project>
